{
  "name": "jit-mcp",
  "version": "1.0.0",
  "description": "Just-in-time skill and MCP tool loader for AI agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanKhor/jit.git"
  },
  "homepage": "https://github.com/StefanKhor/jit",
  "bugs": {
    "url": "https://github.com/StefanKhor/jit/issues"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "skills",
    "just-in-time",
    "context",
    "nemotron",
    "nebius"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "jit": "dist/cli.js"
  },
  "files": [
    "dist",
    "static",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/cli.ts dashboard",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/cli.js dashboard",
    "serve": "node dist/cli.js serve",
    "test": "node --import tsx --test tests/db.test.ts tests/bm25.test.ts tests/scan.test.ts tests/validate.test.ts tests/remote.test.ts tests/github.test.ts tests/retrieval.test.ts tests/marketplace.test.ts tests/dashboard.test.ts tests/mcp.test.ts tests/embedding.test.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm test && npm run build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('static',{recursive:true,force:true})\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
