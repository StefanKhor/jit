# Optional overrides. JIT runs with zero configuration; the dashboard writes
# settings to ~/.jit/config.json. Environment variables are for production.
# JIT does not auto-load .env files; export these in your shell or pass them
# to Docker.

# Nebius Token Factory — optional, enables Nemotron Nano reranking.
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1
NEMOTRON_NANO_MODEL=nvidia/nemotron-nano-9b-v2

# Dashboard/API auth. Leave empty for a local-only dashboard.
JIT_API_KEY=

# Network. The CLI defaults to 127.0.0.1:3000; use 0.0.0.0 behind a proxy.
JIT_HOST=127.0.0.1
JIT_PORT=3000

# Storage, model cache, and logging.
JIT_HOME=~/.jit
JIT_MODEL_CACHE=
JIT_LOG_LEVEL=INFO

# Optional retrieval tuning.
JIT_CONFIDENCE_THRESHOLD=0.60
JIT_TOP_K=20
JIT_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
JIT_EMBEDDING_DIM=384

# Optional remote marketplace catalog(s), comma-separated. JIT ships none of its
# own, so this is how the marketplace gets populated. Each entry is an https
# catalog URL, a GitHub repository (`owner/repo`, `owner/repo@ref`, or a repo
# link), or a skills.sh link (`https://skills.sh/owner/repo[/skill]`) — the two
# repository shapes are resolved with the `skills` CLI. The skills.sh directory
# itself is browsable from the dashboard without configuring anything. Also
# manageable from the dashboard.
JIT_MARKETPLACE_URL=
# Optional token for private GitHub repositories, read by the skills CLI.
JIT_GITHUB_TOKEN=
# Optional command used to resolve repository sources. Defaults to the published
# skills CLI; point it at a local install to avoid npx, or pin a version with
# JIT_SKILLS_CLI_VERSION.
JIT_SKILLS_CLI=
JIT_SKILLS_CLI_VERSION=
# Optional base URL of the skills.sh directory API that backs the Marketplace
# browser. Defaults to the public directory.
JIT_SKILLS_SH_URL=

# Air-gapped installs can skip the embedding model entirely and run on the
# lexical (keyword) fallback. Set to 1 to disable embeddings.
JIT_DISABLE_EMBEDDINGS=

# Request and skill size limits.
JIT_MAX_REQUEST_BYTES=16777216
JIT_MAX_SKILL_BYTES=2097152

# NixOS only: a directory containing libstdc++.so.6 (see README).
# JIT_LD_LIBRARY_PATH=/nix/store/.../usr/lib64
