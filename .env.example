# JIT Environment Variables
# Copy this file to .env and fill in your values

# Nebius API (for Nemotron reranking - optional but recommended)
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1
NEMOTRON_NANO_MODEL=nvidia/nemotron-nano
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra

# Dashboard auth (optional, recommended for production)
JIT_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
JIT_LOG_LEVEL=INFO